{
  "name": "@johnhenry/jth-stdlib",
  "version": "0.0.0",
  "description": "Standard library of operators for the jth language. Importing this package registers all built-in operators into the global @johnhenry/jth-runtime registry.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/jth.git",
    "directory": "packages/jth-stdlib"
  },
  "homepage": "https://opensource.johnhenry.me/jth/",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@johnhenry/jth-types": "^0.0.0",
    "@johnhenry/jth-runtime": "^0.0.0"
  },
  "license": "MIT"
}
