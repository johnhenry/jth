{
  "name": "jth-runtime",
  "version": "0.3.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stack": {
      "types": "./dist/stack.d.ts",
      "default": "./dist/stack.js"
    },
    "./op": {
      "types": "./dist/op.d.ts",
      "default": "./dist/op.js"
    },
    "./meta": {
      "types": "./dist/meta.d.ts",
      "default": "./dist/meta.js"
    },
    "./process-n": {
      "types": "./dist/process-n.d.ts",
      "default": "./dist/process-n.js"
    },
    "./registry": {
