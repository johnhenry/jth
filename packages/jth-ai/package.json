{
  "name": "@johnhenry/jth-ai",
  "version": "0.0.0",
  "description": "AI integration helpers for the jth runtime via Ollama — a JavaScript-only helper library, not a jth op package.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/jth.git",
    "directory": "packages/jth-ai"
  },
  "homepage": "https://opensource.johnhenry.me/jth/",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ollama": {
      "types": "./dist/ollama.d.ts",
      "default": "./dist/ollama.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@johnhenry/jth-runtime": "^0.0.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  }
}
