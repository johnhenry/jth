{
  "name": "@johnhenry/jth-compiler",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/jth.git",
    "directory": "packages/jth-compiler"
  },
  "homepage": "https://github.com/johnhenry/jth#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lexer": {
      "types": "./dist/lexer.d.ts",
      "default": "./dist/lexer.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "default": "./dist/parser.js"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "default": "./dist/codegen.js"
    },
    "./transform": {
      "types": "./dist/transform.d.ts",
      "default": "./dist/transform.js"
    },
    "./run": {
      "types": "./dist/run.d.ts",
      "default": "./dist/run.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@johnhenry/jth-types": "^0.0.0",
    "@johnhenry/jth-runtime": "^0.0.0"
  },
  "devDependencies": {
    "@johnhenry/jth-stdlib": "^0.0.0"
  },
  "license": "MIT"
}
