{
  "name": "@johnhenry/jth",
  "version": "0.0.0",
  "description": "jth — a stack-based language. CLI: compile and run .jth programs (binary: jth).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/jth.git",
    "directory": "packages/jth-cli"
  },
  "homepage": "https://github.com/johnhenry/jth#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "jth": "./dist/bin/jth.js"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@johnhenry/jth-compiler": "^0.0.0",
    "@johnhenry/jth-runtime": "^0.0.0",
    "@johnhenry/jth-stdlib": "^0.0.0",
    "@johnhenry/jth-types": "^0.0.0",
    "@johnhenry/jth-repl": "^0.0.0",
    "esbuild": "^0.27.3"
  },
  "license": "MIT"
}
