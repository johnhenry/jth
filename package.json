{
  "name": "jth-monorepo",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "packages/jth-types",
    "packages/jth-runtime",
    "packages/jth-compiler",
    "packages/jth-stdlib",
    "packages/jth-repl",
    "packages/jth-html",
    "packages/jth-ai",
    "packages/jth-eval",
    "packages/jth-cli"
  ],
  "devDependencies": {
    "@types/node": "^25.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run build && vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run test/e2e/",
    "typecheck": "turbo run build && tsc -b"
  },
  "allowScripts": {
    "esbuild@0.27.3": true
  },
  "license": "MIT"
}
